// CM Repository System — Prisma schema
// See docs/srs (C:\Users\ekes0\Downloads\CM_Repository_SRS_Markdown\srs_md) for the requirements
// this model is designed against. Section references (FR-*, BR-*) are noted inline.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity & Authorization (3.1 Authentication & Authorization)
// ---------------------------------------------------------------------------

enum UserRole {
  ADMINISTRATOR
  HR_REVIEWER
  MANAGER_READONLY
  AUDITOR
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  image         String?
  role          UserRole  @default(MANAGER_READONLY)
  isActive      Boolean   @default(true)
  // FR-AUTH-5 / BR-7: department scoping, when set restricts an HR Reviewer's
  // employee search & CM record visibility to this department.
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  // Dev-only credential login fallback (see lib/auth.ts). NFR-SEC-1 requires
  // OAuth 2.0 / PKCE for the standard user base; this field is only ever
  // populated for local demo accounts and is never used once a real
  // enterprise IdP (Azure AD / Entra ID) is wired in via FR-AUTH-8.
  passwordHash  String?
  // FR-AUTH-6: surfaced on the login page as an account-lockout condition.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  uploadSessions  UploadSession[]
  uploadedDocs    CmDocument[]     @relation("UploadedBy")
  editedDocs      CmDocument[]     @relation("LastEditedBy")
  auditLogs       AuditLog[]

  @@index([departmentId])
}

// Standard Auth.js (NextAuth v5) adapter models — required for the Prisma
// adapter, and ready to receive real Authorization Code + PKCE tokens from
// an enterprise IdP (FR-AUTH-1, FR-AUTH-8) in addition to the dev provider.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// SAP SuccessFactors Integration (3.2) — thin, periodically synced cache
// ---------------------------------------------------------------------------

model Department {
  id    String @id @default(cuid())
  name  String @unique
  code  String @unique

  employees Employee[]
  users     User[]
}

enum EmploymentStatus {
  ACTIVE
  TERMINATED
  ON_LEAVE
}

model Employee {
  id               String           @id @default(cuid())
  // Employee ID as issued by SAP SuccessFactors (FR-SF-1/3). Uniqueness
  // enforced at the DB level per Data Requirements 6.2.
  employeeId       String           @unique
  firstName        String
  lastName         String
  fullName         String
  // Cached for fast document-name generation (FR-MD-2): initials of first+last name.
  initials         String
  email            String?
  jobTitle         String?
  departmentId     String
  department       Department       @relation(fields: [departmentId], references: [id])
  employmentStatus EmploymentStatus @default(ACTIVE)
  hireDate         DateTime?
  // Where the record came from — 'SuccessFactors' for synced rows, 'Manual'
  // for the FR-SF-7 manual-entry fallback.
  sourceSystem     String           @default("SuccessFactors")
  lastSyncedAt     DateTime         @default(now())

  cmDocuments CmDocument[]

  @@index([departmentId])
  @@index([lastName, firstName])
}

// ---------------------------------------------------------------------------
// Document Metadata & Naming Convention (3.4) / Status Logic (3.5)
// ---------------------------------------------------------------------------

model DocumentType {
  id        String  @id @default(cuid())
  // FR-MD-7: configurable lookup, not hard-coded.
  name      String  @unique
  code      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  cmDocuments CmDocument[]
}

// FR-MD-3: per-month sequence counter, updated inside a DB transaction with
// row-level locking (SELECT ... FOR UPDATE) to guarantee uniqueness under
// concurrent uploads. Keyed by MMYY.
model DocumentSequence {
  monthKey  String @id // e.g. "0726" for July 2026
  lastValue Int    @default(0)
}

model UploadSession {
  id        String   @id @default(cuid())
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  label     String?
  createdAt DateTime @default(now())

  cmDocuments CmDocument[]
}

model CmDocument {
  id             String   @id @default(cuid())
  // FR-MD-1: system-generated unique Document ID (distinct from the
  // human-readable Document Name below).
  documentId     String   @unique
  // FR-MD-2: CM-{Initials}{EmployeeID}-{MMYY}{Sequence}
  documentName   String   @unique

  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id])

  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  // FR-UPL-8 / FR-MD-5
  validPeriodMonths Int
  dateIssued        DateTime
  // FR-MD-6 / BR-2: always Date Issued + Valid Period Months, never
  // independently editable by a user.
  expiryDate        DateTime

  // File OR rich-text body (FR-UPL-3) — exactly one is expected to be set.
  fileKey        String?
  fileName       String?
  fileMimeType   String?
  fileSizeBytes  Int?
  bodyHtml       String?  @db.Text

  uploadSessionId String?
  uploadSession   UploadSession? @relation(fields: [uploadSessionId], references: [id])

  uploadedById String
  uploadedBy   User   @relation("UploadedBy", fields: [uploadedById], references: [id])

  lastEditedById String?
  lastEditedBy   User?   @relation("LastEditedBy", fields: [lastEditedById], references: [id])
  lastEditedAt   DateTime?
  // FR-REC-4: once the edit window elapses, further changes require an
  // administrator-level correction, tracked separately from a normal edit.
  correctionCount Int    @default(0)

  // Soft delete (FR-REC-2): the row and its audit trail are retained for
  // compliance; deleted records are excluded from the dashboard/search/reports.
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([employeeId])
  @@index([documentTypeId])
  @@index([expiryDate])
  @@index([dateIssued])
  @@index([isDeleted])
}

// ---------------------------------------------------------------------------
// Audit Logging (3.9) — append-only
// ---------------------------------------------------------------------------

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  ACCESS_DENIED
  DOCUMENT_UPLOAD
  DOCUMENT_EDIT
  DOCUMENT_CORRECTION
  DOCUMENT_DOWNLOAD
  DOCUMENT_DELETE
  EMPLOYEE_SYNC
  USER_CREATED
  USER_ROLE_CHANGED
}

// FR-AUD-4 / BR-6: append-only. No application code path may update or
// delete rows in this table — enforced by never exposing update/delete for
// this model from the service layer (see lib/audit.ts).
model AuditLog {
  id           String       @id @default(cuid())
  action       AuditAction
  actorUserId  String?
  actor        User?        @relation(fields: [actorUserId], references: [id])
  // Snapshot fields so the log entry stays meaningful even if the actor
  // account is later modified.
  actorEmail   String?
  cmDocumentId String?
  cmDocument   CmDocument?  @relation(fields: [cmDocumentId], references: [id])
  targetType   String?
  targetId     String?
  metadata     Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime     @default(now())

  @@index([action])
  @@index([actorUserId])
  @@index([cmDocumentId])
  @@index([createdAt])
}
