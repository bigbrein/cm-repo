# Standard PostgreSQL connection string. Works with any Postgres host —
# local, Neon, Supabase, Railway, RDS, self-hosted, etc.
DATABASE_URL="postgresql://user:password@localhost:5432/cm_repository?schema=public"

# --- Auth.js (NextAuth v5) -------------------------------------------------
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# AUTH_URL is intentionally left unset — `trustHost: true` in src/auth.ts
# lets Auth.js infer the correct origin from the incoming request, which
# also matters when this runs behind a reverse proxy / load balancer.

# FR-AUTH-1/8: real enterprise IdP (Azure AD / Entra ID). Leave unset to run
# in demo mode with the dev-credentials provider only. Setting these three
# activates "Sign in with Microsoft" (OAuth 2.0 Authorization Code + PKCE)
# without any code changes.
# AUTH_MICROSOFT_ENTRA_ID_ID=""
# AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<tenant-id>/v2.0/"

# Set to "false" to disable the dev-credentials provider and self-service
# registration entirely once a real IdP is configured.
ENABLE_DEV_LOGIN="true"

# FR-AUTH-3: session timeout policy.
SESSION_IDLE_TIMEOUT_MINUTES="30"
SESSION_ABSOLUTE_TIMEOUT_HOURS="12"

# --- SAP SuccessFactors integration (3.2) ----------------------------------
# "mock" runs against seeded local data so the app is runnable without a
# live SuccessFactors tenant; "odata" calls a real SuccessFactors OData API.
SF_MODE="mock"
# SF_API_BASE_URL="https://api<dc>.successfactors.com/odata/v2"
# SF_API_CLIENT_ID=""
# SF_API_CLIENT_SECRET=""
# SF_API_COMPANY_ID=""

# --- Document storage (3.3 / NFR-SEC-4/5) -----------------------------------
# "local" stores files on disk under STORAGE_LOCAL_PATH; "s3" targets AWS S3
# / S3-compatible (e.g. Azure Blob via S3 gateway) using the same adapter
# interface (see lib/storage).
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage"
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION=""
# STORAGE_S3_ENDPOINT=""
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""

# Secret used to sign time-limited document download URLs (FR-REC-5 / NFR-SEC-5).
DOWNLOAD_URL_SECRET=""

# --- Business rules (configurable) -----------------------------------------
# FR-REC-3/4: hours after upload during which the uploader/admin may edit
# metadata; after this window, only an admin-level correction is allowed.
EDIT_WINDOW_HOURS="48"
# FR-REP-6: "Expiring Soon" report window, in days.
EXPIRING_SOON_DAYS="30"
